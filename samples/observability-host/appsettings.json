{
  "Urls": "http://localhost:5099",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CSharpDB.Operational": "Information",
      "CSharpDB.Query": "Information"
    }
  },
  "ConnectionStrings": {
    "CSharpDB": "Data Source=:memory:"
  },
  "CSharpDB": {
    "Observability": {
      "Enabled": true,
      "DatabaseAlias": "sample",
      "Logging": {
        "Enabled": true,
        "Queries": true,
        "SlowQueries": true,
        "SlowQueryThreshold": "00:00:00.500",
        "SqlText": "None"
      },
      "History": {
        "Enabled": true,
        "ActiveQueryCapacity": 100,
        "RecentQueryCapacity": 100,
        "RecentOperationCapacity": 50,
        "Retention": "00:15:00"
      },
      "LongRunningQueryThreshold": "00:00:05",
      "SessionAbandonmentThreshold": "00:30:00",
      "OpenTelemetry": {
        "Enabled": true,
        "SamplingRatio": 1.0,
        "Resource": {
          "ServiceName": "CSharpDB.Observability.Sample",
          "ServiceNamespace": "CSharpDB",
          "DeploymentEnvironment": "development"
        },
        "Otlp": {
          "Enabled": false
        },
        "Console": {
          "Enabled": true
        }
      },
      "Prometheus": {
        "Enabled": true,
        "Path": "/metrics",
        "AllowInsecureRemoteAccess": false
      },
      "Health": {
        "Enabled": true,
        "LivenessPath": "/health/live",
        "ReadinessPath": "/health/ready",
        "ReadinessTimeout": "00:00:02"
      }
    },
    "Api": {
      "Security": {
        "Mode": "None",
        "ApiKeyHeaderName": "X-CSharpDB-Api-Key"
      }
    }
  }
}
