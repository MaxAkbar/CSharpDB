@using CSharpDB.Admin.Models
@inject IDataModelService DataModels
@inject IDataModelDiagramService Diagrams
@inject DatabaseClientHolder DbHolder
@inject TabManagerService TabManager
@inject ToastService Toast
@implements IAsyncDisposable

<div class="data-model-tab">
    <div class="toolbar data-model-toolbar">
        <button class="toolbar-btn primary"
                @onclick="LoadAllAsync"
                disabled="@_loading"
                title="Render all user and external tables">
            @if (_loading)
            {
                <span class="spinner" style="width:12px;height:12px;border-width:2px;"></span>
            }
            <i class="bi bi-diagram-3"></i> Load All
        </button>
        <button class="toolbar-btn @( _showSourcesPane ? "active" : "")"
                @onclick="ToggleSourcesPane"
                disabled="@_loading"
                title="Show searchable model sources">
            <i class="bi bi-layout-sidebar-inset"></i> Sources
        </button>
        <button class="toolbar-btn @(_showInspectorPane ? "active" : "")"
                @onclick="ToggleInspectorPane"
                disabled="@_loading"
                title="Show model details, relationships, and pending changes">
            <i class="bi bi-layout-sidebar-inset-reverse"></i> Details
        </button>
        <button class="toolbar-btn"
                @onclick="ToggleNewTablePanel"
                disabled="@_loading"
                title="Stage a new database table">
            <i class="bi bi-table"></i> New Table
        </button>
        <button class="toolbar-btn" @onclick="RefreshAsync" disabled="@_loading" title="Reload metadata">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
        <button class="toolbar-btn" @onclick="ClearCanvas" disabled="@(_loading || _state.Nodes.Count == 0)" title="Clear canvas">
            <i class="bi bi-eraser"></i> Clear
        </button>

        <div class="toolbar-separator"></div>
        <button class="toolbar-btn" @onclick="AutoArrangeAsync" disabled="@(_loading || _state.Nodes.Count == 0)" title="Arrange parents left of dependent tables">
            <i class="bi bi-distribute-horizontal"></i> Auto Arrange
        </button>
        <button class="toolbar-btn" @onclick="TidyModelAsync" disabled="@(_loading || _state.Nodes.Count == 0)" title="Reset custom connector routes, use Keys First, arrange tables, and fit the complete model">
            <i class="bi bi-stars"></i> Tidy Model
        </button>
        <button class="toolbar-btn" @onclick="FitModelAsync" disabled="@(_loading || _state.Nodes.Count == 0)" title="Fit the complete model in the canvas">
            <i class="bi bi-arrows-fullscreen"></i> Fit Model
        </button>
        <button class="toolbar-btn" @onclick="() => SetAllDetailLevelsAsync(DataModelNodeDetailLevel.Keys)" disabled="@(_loading || _state.Nodes.Count == 0)" title="Show keys and relationship columns">
            <i class="bi bi-key"></i> Keys First
        </button>
        <button class="toolbar-btn icon-only" @onclick="() => SetAllDetailLevelsAsync(DataModelNodeDetailLevel.All)" disabled="@(_loading || _state.Nodes.Count == 0)" title="Expand all tables" aria-label="Expand all tables">
            <i class="bi bi-arrows-expand"></i>
        </button>
        <button class="toolbar-btn icon-only" @onclick="() => SetAllDetailLevelsAsync(DataModelNodeDetailLevel.Collapsed)" disabled="@(_loading || _state.Nodes.Count == 0)" title="Collapse all tables" aria-label="Collapse all tables">
            <i class="bi bi-arrows-collapse"></i>
        </button>

        <div class="toolbar-separator"></div>
        <button class="toolbar-btn icon-only"
                @onclick="ZoomOut"
                disabled="@(_loading || CurrentScale <= MinZoom)"
                title="Zoom out">
            <i class="bi bi-zoom-out"></i>
        </button>
        <span class="data-model-zoom-label">@ZoomLabel</span>
        <button class="toolbar-btn"
                @onclick="ResetZoom"
                disabled="@(_loading || Math.Abs(CurrentScale - 1) < 0.001)"
                title="Reset zoom">
            <i class="bi bi-aspect-ratio"></i> Reset
        </button>
        <button class="toolbar-btn icon-only"
                @onclick="ZoomIn"
                disabled="@(_loading || CurrentScale >= MaxZoom)"
                title="Zoom in">
            <i class="bi bi-zoom-in"></i>
        </button>

        <div class="toolbar-separator"></div>
        <input class="query-saved-input"
               style="width:130px"
               @bind="_diagramName"
               placeholder="Diagram name..." />
        <button class="toolbar-btn"
                @onclick="SaveDiagramAsync"
                disabled="@(_loading || string.IsNullOrWhiteSpace(_diagramName))"
                title="Save diagram">
            <i class="bi bi-save"></i> Save
        </button>
        <div class="designer-dropdown-wrap">
            <button class="toolbar-btn" @onclick="ToggleLoadPanel" disabled="@_loading" title="Open a saved diagram">
                <i class="bi bi-folder2-open"></i> Load <i class="bi bi-chevron-down" style="font-size:10px"></i>
            </button>
            @if (_showLoadPanel)
            {
                <div class="designer-dropdown-panel">
                    @if (!_savedDiagrams.Any())
                    {
                        <div class="designer-dropdown-empty">No saved diagrams</div>
                    }
                    else
                    {
                        @foreach (DataModelDiagramSummary diagram in _savedDiagrams)
                        {
                            var saved = diagram;
                            <button class="designer-dropdown-item" @onclick="() => LoadDiagramAsync(saved.Name)">
                                <i class="bi bi-diagram-3"></i>
                                <span>@saved.Name</span>
                                <small>@saved.SourceCount source@(saved.SourceCount == 1 ? "" : "s")</small>
                            </button>
                        }
                    }
                </div>
            }
        </div>
        <button class="toolbar-btn danger"
                @onclick="DeleteActiveDiagramAsync"
                disabled="@(_loading || !HasPersistedActiveDiagram)"
                title="Delete the saved diagram record">
            <i class="bi bi-trash"></i> Delete
        </button>

        <div class="toolbar-separator"></div>
        <button class="toolbar-btn primary"
                @onclick="ApplyPendingChangesAsync"
                disabled="@(_loading || _state.PendingOperations.Count == 0)"
                title="Apply staged schema changes">
            <i class="bi bi-check2-circle"></i> Apply Changes
        </button>
        <button class="toolbar-btn"
                @onclick="OpenInQueryDesigner"
                disabled="@(_state.Nodes.Count == 0)"
                title="Open current model as a visual query designer layout">
            <i class="bi bi-box-arrow-up-right"></i> Open in Query Designer
        </button>
        <AdminRouteSelector Tab="Tab" RouteChanged="OnRouteChangedAsync" />
        <div class="toolbar-spacer"></div>
        <div class="toolbar-info">
            <span>@_state.Nodes.Count source@(_state.Nodes.Count == 1 ? "" : "s")</span>
            <span>|</span>
            <span>@_state.Relationships.Count relationship@(_state.Relationships.Count == 1 ? "" : "s")</span>
        </div>
    </div>

    @if (RequiresRouteContext)
    {
        <div class="query-error">
            <i class="bi bi-signpost-split"></i> Select a route before using the data model workspace on a sharded database.
        </div>
    }
    else
    {
    @if (_showNewTablePanel)
    {
        <div class="designer-join-dialog data-model-schema-dialog">
            <span class="designer-join-dialog-title">New Table</span>
            <input class="schema-input"
                   style="width:160px"
                   @bind="_newTableName"
                   placeholder="Table name" />
            <input class="schema-input"
                   style="width:120px"
                   @bind="_newTablePrimaryKeyName"
                   placeholder="PK column" />
            <select class="schema-input" style="width:110px" @bind="_newTablePrimaryKeyType">
                <option>INTEGER</option>
                <option>BIGINT</option>
                <option>SMALLINT</option>
                <option>TINYINT</option>
                <option>UUID</option>
                <option>TEXT</option>
                <option>REAL</option>
                <option>DOUBLE PRECISION</option>
                <option>DECIMAL</option>
                <option>BLOB</option>
            </select>
            <button class="toolbar-btn primary"
                    disabled="@(!CanStageNewTable)"
                    @onclick="StageNewTableAsync">
                <i class="bi bi-plus"></i> Stage
            </button>
            <button class="toolbar-btn" @onclick="ToggleNewTablePanel">Cancel</button>
        </div>
    }

    @if (_error is not null)
    {
        <div class="query-error" role="alert"><i class="bi bi-exclamation-triangle"></i> @_error</div>
    }
    @if (_diagramSaveError is not null)
    {
        <div class="query-error" role="alert">@_diagramSaveError Your layout is still open in this tab. Use Save to retry before closing.</div>
    }

    @if (_confirmTidyRoutes)
    {
        <div class="data-model-layout-notice" role="alert">
            <span>Tidy Model will reset all custom connector routes and rearrange the tables. Continue?</span>
            <button class="toolbar-btn primary" @onclick="ApplyTidyModelAsync">Tidy and reset routes</button>
            <button class="toolbar-btn" @onclick="() => _confirmTidyRoutes = false">Cancel</button>
        </div>
    }

    @if (LayoutOverlapCount > 0)
    {
        <div class="data-model-layout-notice">
            <i class="bi bi-exclamation-triangle"></i>
            <span>This saved layout has @LayoutOverlapCount overlapping table pair@(LayoutOverlapCount == 1 ? "" : "s").</span>
            <button class="toolbar-btn" @onclick="TidyModelAsync"><i class="bi bi-stars"></i> Tidy Model</button>
        </div>
    }

    <div class="data-model-workspace @(_showSourcesPane ? "with-sources" : null) @(_showInspectorPane ? "with-inspector" : null)">
        @if (_showSourcesPane)
        {
            <aside class="data-model-sources">
                <div class="data-model-sources-header">
                    <div>
                        <strong>Sources</strong>
                        <small>@AvailableSourceOptions.Count() available</small>
                    </div>
                    <button class="designer-node-close" title="Close Sources" @onclick="ToggleSourcesPane">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <label class="data-model-source-search">
                    <i class="bi bi-search"></i>
                    <input value="@_sourceSearch"
                           @oninput="eventArgs => _sourceSearch = eventArgs.Value?.ToString() ?? string.Empty"
                           placeholder="Search tables..."
                           aria-label="Search model sources" />
                </label>
                <div class="data-model-source-list">
                    @foreach (DataModelSourceOption option in FilteredSourceOptions)
                    {
                        var source = option;
                        <div class="data-model-source-row">
                            <i class="bi @(source.Kind == DataModelNodeKind.ExternalTable ? "bi-box-arrow-up-right" : "bi-table")"></i>
                            <span title="@source.Name">@source.Name</span>
                            <button class="toolbar-btn" @onclick="() => AddSourceAsync(source.Name, includeRelated: false)" title="Add only @source.Name">Add</button>
                            <button class="toolbar-btn icon-only" @onclick="() => AddSourceAsync(source.Name, includeRelated: true)" title="Add @source.Name with directly related tables" aria-label="Add @source.Name with related tables">
                                <i class="bi bi-diagram-2"></i>
                            </button>
                        </div>
                    }
                    @if (!FilteredSourceOptions.Any())
                    {
                        <div class="designer-dropdown-empty">No matching sources</div>
                    }
                </div>
            </aside>
        }
        <section class="data-model-canvas-panel">
            <SchemaCanvas @ref="_schemaCanvas"
                          State="_state"
                          SelectedNodeName="@_selectedNodeName"
                          SelectedRelationshipId="@_selectedRelationshipId"
                          OnNodeSelected="SelectNode"
                          OnNodeRemoved="RemoveNode"
                          OnRelationshipSelected="SelectRelationship"
                          OnSelectionCleared="ClearSelection"
                          OnNodeMoved="OnNodeMoved"
                          OnNodeDetailChanged="OnNodeDetailChangedAsync"
                          OnConnectorRouteChanged="OnConnectorRouteChangedAsync"
                          OnConnectorWaypointSelected="OnConnectorWaypointSelected"
                          OnViewportChanged="OnViewportChangedAsync" />
        </section>
        @if (_showInspectorPane)
        {
        <aside class="data-model-inspector">
            <div class="data-model-inspector-header">
                <strong>Model details</strong>
                <button class="designer-node-close" title="Close model details" aria-label="Close model details" @onclick="ToggleInspectorPane">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="data-model-inspector-section">
                <h3>Selection</h3>
                @if (SelectedNode is not null)
                {
                    <div class="data-model-selection-card">
                        <strong>@SelectedNode.Name</strong>
                        <span>@(SelectedNode.Kind == DataModelNodeKind.ExternalTable ? "External table" : "Table")</span>
                        @if (!string.IsNullOrWhiteSpace(SelectedNode.SourceTableName))
                        {
                            <small>Source: @SelectedNode.SourceTableName</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedNode.ArchivePath))
                        {
                            <small class="mono-cell">@SelectedNode.ArchivePath</small>
                        }
                        @if (SelectedNode.IsDraft)
                        {
                            <small>Pending create table</small>
                        }
                    </div>

                    @if (SelectedNode.Kind == DataModelNodeKind.Table && !SelectedNode.IsDraft)
                    {
                        <div class="data-model-schema-actions">
                            <div class="data-model-inline-action">
                                <input class="schema-input"
                                       value="@_renameTableName"
                                       @oninput="eventArgs => _renameTableName = eventArgs.Value?.ToString() ?? string.Empty"
                                       placeholder="New table name" />
                                <button class="toolbar-btn"
                                        disabled="@(!CanStageRenameSelectedTable)"
                                        @onclick="StageRenameSelectedTableAsync"
                                        title="Stage a table rename">
                                    <i class="bi bi-pencil"></i> Rename Table
                                </button>
                            </div>
                            <div class="data-model-inline-action">
                                <input class="schema-input"
                                       value="@_newColumnName"
                                       @oninput="eventArgs => _newColumnName = eventArgs.Value?.ToString() ?? string.Empty"
                                       placeholder="Column name" />
                                <select class="schema-input" @bind="_newColumnType">
                                    <option>TEXT</option>
                                    <option>BOOLEAN</option>
                                    <option>TINYINT</option>
                                    <option>SMALLINT</option>
                                    <option>INTEGER</option>
                                    <option>BIGINT</option>
                                    <option>REAL</option>
                                    <option>DOUBLE PRECISION</option>
                                    <option>DECIMAL</option>
                                    <option>CHAR</option>
                                    <option>VARCHAR</option>
                                    <option>BINARY</option>
                                    <option>VARBINARY</option>
                                    <option>BLOB</option>
                                    <option>UUID</option>
                                    <option>DATE</option>
                                    <option>TIME</option>
                                    <option>DATETIME2</option>
                                    <option>DATETIMEOFFSET</option>
                                    <option>INTERVAL YEAR TO MONTH</option>
                                    <option>INTERVAL DAY TO SECOND</option>
                                    <option>JSON</option>
                                    <option>XML</option>
                                    <option>BIT</option>
                                    <option>BIT VARYING</option>
                                </select>
                                <label class="schema-check">
                                    <input type="checkbox" @bind="_newColumnNotNull" />
                                    <span>Not null</span>
                                </label>
                                <button class="toolbar-btn"
                                        disabled="@(!CanStageAddColumn)"
                                        @onclick="StageAddColumnAsync"
                                        title="Stage an ADD COLUMN operation">
                                    <i class="bi bi-plus"></i> Add Column
                                </button>
                            </div>
                            <div class="data-model-column-action-list">
                                @foreach (DataModelColumn column in SelectedNode.Columns)
                                {
                                    var currentColumn = column;
                                    <div class="data-model-column-action-row">
                                        <span>
                                            <strong>@currentColumn.Name</strong>
                                            <small>@currentColumn.TypeLabel</small>
                                        </span>
                                        <input class="schema-input"
                                               value="@GetColumnRenameValue(SelectedNode.Name, currentColumn.Name)"
                                               @oninput="eventArgs => SetColumnRenameValue(SelectedNode.Name, currentColumn.Name, eventArgs.Value?.ToString())"
                                               placeholder="Rename to" />
                                        <button class="toolbar-btn"
                                                disabled="@(!CanStageRenameColumn(SelectedNode, currentColumn))"
                                                @onclick="() => StageRenameColumnAsync(SelectedNode.Name, currentColumn.Name)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="toolbar-btn danger"
                                                disabled="@(currentColumn.IsPrimaryKey || HasPendingTableRename(SelectedNode.Name) || HasPendingColumnDrop(SelectedNode.Name, currentColumn.Name))"
                                                @onclick="() => StageDropColumnAsync(SelectedNode.Name, currentColumn.Name)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            <button class="toolbar-btn danger"
                                    disabled="@HasPendingDropForSelectedNode"
                                    @onclick="StageDropSelectedTableAsync"
                                    title="Stage a DROP TABLE operation">
                                <i class="bi bi-trash"></i> Drop Table...
                            </button>
                        </div>
                    }
                }
                else if (SelectedRelationship is not null)
                {
                    <div class="data-model-selection-card">
                        <strong>@SelectedRelationship.LeftTable.@SelectedRelationship.LeftColumn</strong>
                        <span>references @SelectedRelationship.RightTable.@SelectedRelationship.RightColumn</span>
                        <small>@RelationshipKindLabel(SelectedRelationship.Kind)</small>
                    </div>
                    <div class="data-model-connector-actions">
                        <h4>Connector route <small>@(SelectedRelationship.ConnectorLayout is null ? "Automatic" : "Custom")</small></h4>
                        <p class="data-model-muted">Layout only; does not change the foreign key.</p>
                        <div class="data-model-connector-buttons">
                            <button class="toolbar-btn" disabled="@(!CanEditSelectedConnector)" @onclick="AddConnectorBendAsync">Add Bend</button>
                            <button class="toolbar-btn" disabled="@(!CanRemoveSelectedBend)" @onclick="RemoveConnectorBendAsync">Remove Bend</button>
                            <button class="toolbar-btn" disabled="@(SelectedRelationship.ConnectorLayout is null)" @onclick="ResetConnectorRouteAsync">Reset to Automatic</button>
                        </div>
                        <p class="data-model-muted">Drag a bend or segment grip. Arrow keys move the focused bend; Shift moves farther. Delete removes only a bend. Escape cancels a drag or clears selection.</p>
                    </div>
                    @if (SelectedRelationship.Kind != DataModelRelationshipKind.ExternalArchiveForeignKey)
                    {
                        <div class="data-model-schema-actions">
                            <button class="toolbar-btn"
                                    @onclick="OpenSelectedRelationshipHygiene"
                                    title="Find child rows without a parent">
                                <i class="bi bi-shield-check"></i> Find Orphans
                            </button>
                            <button class="toolbar-btn danger"
                                    disabled="@HasPendingDropForSelectedRelationship"
                                    @onclick="StageDropSelectedRelationshipAsync"
                                    title="Stage relationship removal">
                                <i class="bi bi-trash"></i> Drop Relationship...
                            </button>
                        </div>
                    }
                }
                else
                {
                    <p class="data-model-muted">Select a table or relationship.</p>
                }
            </div>

            <div class="data-model-inspector-section">
                <h3>Relationships</h3>
                @if (_state.Relationships.Count == 0)
                {
                    <p class="data-model-muted">No relationships on the canvas.</p>
                }
                else
                {
                    @foreach (DataModelRelationship relationship in _state.Relationships)
                    {
                        var current = relationship;
                        <button class="data-model-relationship-row @(string.Equals(_selectedRelationshipId, current.Id, StringComparison.Ordinal) ? "active" : "")"
                                @onclick="() => SelectRelationship(current.Id)">
                            <i class="bi @(current.Kind == DataModelRelationshipKind.ExternalArchiveForeignKey ? "bi-box-arrow-up-right" : "bi-link-45deg")"></i>
                            <span>@current.LeftTable.@current.LeftColumn</span>
                            <small>@current.RightTable.@current.RightColumn</small>
                        </button>
                    }
                }
                @if (MutableTableNodes.Count >= 2)
                {
                    <div class="data-model-relationship-editor">
                        <select class="schema-input" @bind="_relationshipLeftTable">
                            <option value="">Child table</option>
                            @foreach (DataModelNode node in MutableTableNodes)
                            {
                                <option value="@node.Name">@node.Name</option>
                            }
                        </select>
                        <select class="schema-input" @bind="_relationshipLeftColumn">
                            <option value="">Child column</option>
                            @foreach (DataModelColumn column in RelationshipLeftColumns)
                            {
                                <option value="@column.Name">@column.Name</option>
                            }
                        </select>
                        <select class="schema-input" @bind="_relationshipRightTable">
                            <option value="">Parent table</option>
                            @foreach (DataModelNode node in MutableTableNodes)
                            {
                                <option value="@node.Name">@node.Name</option>
                            }
                        </select>
                        <select class="schema-input" @bind="_relationshipRightColumn">
                            <option value="">Parent column</option>
                            @foreach (DataModelColumn column in RelationshipRightColumns)
                            {
                                <option value="@column.Name">@column.Name</option>
                            }
                        </select>
                        <select class="schema-input" @bind="_relationshipOnDelete">
                            <option>RESTRICT</option>
                            <option>NO ACTION</option>
                            <option>CASCADE</option>
                            <option disabled="@(!CanSelectSetNull)">SET NULL</option>
                            <option disabled="@(!CanSelectSetDefault)">SET DEFAULT</option>
                        </select>
                        <select class="schema-input" @bind="_relationshipOnUpdate">
                            <option>RESTRICT</option>
                            <option>NO ACTION</option>
                            <option>CASCADE</option>
                            <option disabled="@(!CanSelectSetNull)">SET NULL</option>
                            <option disabled="@(!CanSelectSetDefault)">SET DEFAULT</option>
                        </select>
                        <button class="toolbar-btn"
                                disabled="@(!CanStageRelationship)"
                                @onclick="StageRelationshipAsync">
                            <i class="bi bi-link-45deg"></i> Add Relationship
                        </button>
                    </div>
                }
            </div>

            @if (AllWarnings.Count > 0)
            {
                <div class="data-model-inspector-section">
                    <h3>Warnings</h3>
                    @foreach (string warning in AllWarnings)
                    {
                        <div class="data-model-warning"><i class="bi bi-exclamation-triangle"></i> @warning</div>
                    }
                </div>
            }

            <div class="data-model-inspector-section">
                <h3>Pending Changes</h3>
                @if (_state.PendingOperations.Count == 0)
                {
                    <p class="data-model-muted">No staged schema changes.</p>
                }
                else
                {
                    @foreach (DataModelPendingOperation operation in _state.PendingOperations)
                    {
                        var current = operation;
                        <div class="data-model-pending-row">
                            <span>@current.Description</span>
                            <button class="designer-node-close"
                                    title="Remove pending change"
                                    @onclick="() => RemovePendingOperationAsync(current.Id)">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }
                }
            </div>

            <div class="data-model-inspector-section preview">
                <h3>Pending SQL</h3>
                <pre>@PendingPreviewSql</pre>
            </div>
        </aside>
        }
    </div>
    }
</div>

@code {
    private const string DefaultDiagramName = "Default Diagram";
    private const double MinZoom = 0.5;
    private const double MaxZoom = 2.0;
    private const double ZoomStep = 0.1;

    [Parameter] public TabDescriptor Tab { get; set; } = default!;

    private DataModelState _state = new();
    private IReadOnlyList<DataModelSourceOption> _sourceOptions = [];
    private IReadOnlyList<DataModelDiagramSummary> _savedDiagrams = [];
    private string? _selectedNodeName;
    private string? _selectedRelationshipId;
    private string? _selectedWaypointId;
    private bool _confirmTidyRoutes;
    private string _diagramName = "";
    private string _newTableName = "";
    private string _newTablePrimaryKeyName = "Id";
    private string _newTablePrimaryKeyType = "INTEGER";
    private string _renameTableName = "";
    private string _newColumnName = "";
    private string _newColumnType = "TEXT";
    private bool _newColumnNotNull;
    private readonly Dictionary<string, string> _columnRenameNames = new(StringComparer.OrdinalIgnoreCase);
    private string _relationshipLeftTable = "";
    private string _relationshipLeftColumn = "";
    private string _relationshipRightTable = "";
    private string _relationshipRightColumn = "";
    private string _relationshipOnDelete = "RESTRICT";
    private string _relationshipOnUpdate = "RESTRICT";
    private SchemaCanvas? _schemaCanvas;
    private bool _showSourcesPane;
    private bool _showInspectorPane;
    private bool _showLoadPanel;
    private bool _showNewTablePanel;
    private bool _hasDiagramMutation;
    private bool _loading;
    private bool _fitAfterRender;
    private string _sourceSearch = "";
    private string? _error;
    private string? _diagramSaveError;
    private CancellationTokenSource? _viewportPersistCts;
    private AdminRouteClientLease? _routeLease;
    private DataModelService? _routeDataModelService;

    private IEnumerable<DataModelSourceOption> AvailableSourceOptions =>
        _sourceOptions.Where(option => !_state.Nodes.Any(node => string.Equals(node.Name, option.Name, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<DataModelSourceOption> FilteredSourceOptions =>
        AvailableSourceOptions.Where(option =>
            string.IsNullOrWhiteSpace(_sourceSearch) ||
            option.Name.Contains(_sourceSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private DataModelNode? SelectedNode =>
        string.IsNullOrWhiteSpace(_selectedNodeName)
            ? null
            : _state.Nodes.FirstOrDefault(node => string.Equals(node.Name, _selectedNodeName, StringComparison.OrdinalIgnoreCase));

    private DataModelRelationship? SelectedRelationship =>
        string.IsNullOrWhiteSpace(_selectedRelationshipId)
            ? null
            : _state.Relationships.FirstOrDefault(relationship => string.Equals(relationship.Id, _selectedRelationshipId, StringComparison.Ordinal));

    private bool CanEditSelectedConnector => SelectedRelationship is { IsResolved: true } relationship &&
        FindNode(relationship.LeftTable) is not null && FindNode(relationship.RightTable) is not null;

    private bool CanRemoveSelectedBend => CanEditSelectedConnector && _selectedWaypointId is not null &&
        SelectedRelationship?.ConnectorLayout?.Waypoints.Any(point => point.Id == _selectedWaypointId) == true;

    private IReadOnlyList<DataModelNode> MutableTableNodes =>
        _state.Nodes
            .Where(static node => node.Kind == DataModelNodeKind.Table)
            .OrderBy(static node => node.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<DataModelColumn> RelationshipLeftColumns =>
        FindNode(_relationshipLeftTable)?.Columns.OrderBy(static column => column.Name, StringComparer.OrdinalIgnoreCase).ToArray() ?? [];

    private IReadOnlyList<DataModelColumn> RelationshipRightColumns =>
        FindNode(_relationshipRightTable)?.Columns.OrderBy(static column => column.Name, StringComparer.OrdinalIgnoreCase).ToArray() ?? [];

    private IReadOnlyList<string> AllWarnings =>
        _state.Warnings
            .Concat(_state.Nodes.SelectMany(static node => node.Warnings.Select(warning => $"{node.Name}: {warning}")))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private AdminRouteClientLease RouteLease => _routeLease ??= new AdminRouteClientLease(DbHolder);
    private IDataModelService ActiveDataModels => _routeDataModelService ?? DataModels;
    private IDataModelDiagramService ActiveDiagrams => _routeDataModelService ?? Diagrams;
    private bool RequiresRouteContext => DbHolder.SupportsShardAdmin && DbHolder.SupportsRouteBoundClients && Tab?.HasRouteContext != true;

    private string PendingPreviewSql => ActiveDataModels.BuildPendingOperationsPreview(_state);

    private double CurrentScale => NormalizeScale(_state.Scale);

    private string ZoomLabel => $"{Math.Round(CurrentScale * 100):0}%";

    private bool CanStageNewTable =>
        !string.IsNullOrWhiteSpace(_newTableName)
        && !string.IsNullOrWhiteSpace(_newTablePrimaryKeyName)
        && !_state.Nodes.Any(node => string.Equals(node.Name, _newTableName.Trim(), StringComparison.OrdinalIgnoreCase))
        && !_sourceOptions.Any(option => string.Equals(option.Name, _newTableName.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool HasPendingDropForSelectedNode =>
        SelectedNode is not null &&
        _state.PendingOperations.Any(operation =>
            operation.Kind == DataModelPendingOperationKind.DropTable &&
            string.Equals(operation.TableName, SelectedNode.Name, StringComparison.OrdinalIgnoreCase));

    private bool CanStageRenameSelectedTable =>
        SelectedNode is { Kind: DataModelNodeKind.Table, IsDraft: false }
        && !HasPendingDropForSelectedNode
        && !HasPendingTableRename(SelectedNode.Name)
        && !string.IsNullOrWhiteSpace(_renameTableName)
        && !string.Equals(_renameTableName.Trim(), SelectedNode.Name, StringComparison.OrdinalIgnoreCase)
        && !_sourceOptions.Any(option => string.Equals(option.Name, _renameTableName.Trim(), StringComparison.OrdinalIgnoreCase))
        && !_state.Nodes.Any(node => string.Equals(node.Name, _renameTableName.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool CanStageAddColumn =>
        SelectedNode is { Kind: DataModelNodeKind.Table, IsDraft: false }
        && !HasPendingDropForSelectedNode
        && !HasPendingTableRename(SelectedNode.Name)
        && !string.IsNullOrWhiteSpace(_newColumnName)
        && !SelectedNode.Columns.Any(column => string.Equals(column.Name, _newColumnName.Trim(), StringComparison.OrdinalIgnoreCase))
        && !_state.PendingOperations.Any(operation =>
            operation.Kind == DataModelPendingOperationKind.AddColumn &&
            string.Equals(operation.TableName, SelectedNode.Name, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(operation.ColumnName, _newColumnName.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool CanStageRelationship =>
        !string.IsNullOrWhiteSpace(_relationshipLeftTable)
        && !string.IsNullOrWhiteSpace(_relationshipLeftColumn)
        && !string.IsNullOrWhiteSpace(_relationshipRightTable)
        && !string.IsNullOrWhiteSpace(_relationshipRightColumn)
        && !string.Equals(_relationshipLeftTable, _relationshipRightTable, StringComparison.OrdinalIgnoreCase)
        && FindNode(_relationshipLeftTable) is { Kind: DataModelNodeKind.Table }
        && FindNode(_relationshipRightTable) is { Kind: DataModelNodeKind.Table }
        && RelationshipLeftColumns.Any(column => string.Equals(column.Name, _relationshipLeftColumn, StringComparison.OrdinalIgnoreCase))
        && RelationshipRightColumns.Any(column => string.Equals(column.Name, _relationshipRightColumn, StringComparison.OrdinalIgnoreCase))
        && DataModelRelationshipRules.IsActionCompatible(
            _relationshipOnDelete,
            SelectedRelationshipLeftColumn)
        && DataModelRelationshipRules.IsActionCompatible(
            _relationshipOnUpdate,
            SelectedRelationshipLeftColumn)
        && !_state.Relationships.Any(relationship =>
            string.Equals(relationship.LeftTable, _relationshipLeftTable, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(relationship.LeftColumn, _relationshipLeftColumn, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(relationship.RightTable, _relationshipRightTable, StringComparison.OrdinalIgnoreCase) &&
             string.Equals(relationship.RightColumn, _relationshipRightColumn, StringComparison.OrdinalIgnoreCase));

    private DataModelColumn? SelectedRelationshipLeftColumn =>
        RelationshipLeftColumns.FirstOrDefault(column =>
            string.Equals(
                column.Name,
                _relationshipLeftColumn,
                StringComparison.OrdinalIgnoreCase));

    private bool CanSelectSetNull =>
        DataModelRelationshipRules.IsActionCompatible(
            "SET NULL",
            SelectedRelationshipLeftColumn);

    private bool CanSelectSetDefault =>
        DataModelRelationshipRules.IsActionCompatible(
            "SET DEFAULT",
            SelectedRelationshipLeftColumn);

    private bool HasPendingDropForSelectedRelationship =>
        SelectedRelationship is not null &&
        _state.PendingOperations.Any(operation =>
            operation.Kind == DataModelPendingOperationKind.DropForeignKey &&
            (string.Equals(operation.ConstraintName, SelectedRelationship.ConstraintName, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(operation.ConstraintName, SelectedRelationship.Id, StringComparison.OrdinalIgnoreCase)));

    private bool UsesDefaultDiagram =>
        string.IsNullOrWhiteSpace(Tab?.InitialDataModelSourceName);

    private bool HasPersistedActiveDiagram =>
        !string.IsNullOrWhiteSpace(_state.DiagramName) &&
        _savedDiagrams.Any(diagram => string.Equals(diagram.Name, _state.DiagramName, StringComparison.OrdinalIgnoreCase));

    private int LayoutOverlapCount => DataModelLayoutEngine.CountOverlaps(_state);

    protected override async Task OnInitializedAsync()
    {
        await RouteLease.UpdateAsync(Tab);
        RebuildRouteServices();

        if (!RequiresRouteContext)
            await LoadInitialAsync();
    }

    protected override void OnParametersSet()
    {
        if (Tab?.DataModelStateJson is not null && _state.Nodes.Count == 0)
        {
            try
            {
                DataModelState? saved = DataModelGraphBuilder.DeserializeState(Tab.DataModelStateJson);
                if (saved is not null)
                {
                    _state = saved;
                    NormalizeZoom();
                    EnsureDefaultDiagramName();
                    _diagramName = _state.DiagramName ?? _state.SavedLayoutName ?? "";
                    _hasDiagramMutation = _state.Nodes.Count > 0 || _state.PendingOperations.Count > 0;
                }
            }
            catch
            {
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_fitAfterRender || _schemaCanvas is null)
            return;

        _fitAfterRender = false;
        await _schemaCanvas.FitModelAsync();
    }

    private async Task OnRouteChangedAsync(CSharpDbRouteContext? routeContext)
    {
        await RouteLease.UpdateAsync(Tab);
        RebuildRouteServices();
        ResetRouteScopedState();

        if (!RequiresRouteContext)
            await LoadInitialAsync();
    }

    private void RebuildRouteServices()
    {
        _routeDataModelService = RouteLease.RouteClient is null
            ? null
            : new DataModelService(RouteLease.RouteClient);
    }

    private void ResetRouteScopedState()
    {
        _confirmTidyRoutes = false;
        _selectedWaypointId = null;
        _diagramSaveError = null;
        _state = new DataModelState();
        _sourceOptions = [];
        _savedDiagrams = [];
        _selectedNodeName = null;
        _selectedRelationshipId = null;
        _diagramName = "";
        _showSourcesPane = false;
        _showInspectorPane = false;
        _showLoadPanel = false;
        _showNewTablePanel = false;
        _hasDiagramMutation = false;
        _sourceSearch = "";
        _error = null;
    }

    private async Task LoadInitialAsync()
    {
        _confirmTidyRoutes = false;
        _selectedWaypointId = null;
        _loading = true;
        _error = null;
        try
        {
            _sourceOptions = await ActiveDataModels.GetSourceOptionsAsync();
            _savedDiagrams = await ActiveDiagrams.GetDiagramsAsync();
            if (Tab?.DataModelStateJson is not null)
            {
                DataModelState? saved = DataModelGraphBuilder.DeserializeState(Tab.DataModelStateJson);
                if (saved is not null)
                {
                    _state = saved;
                    NormalizeZoom();
                    EnsureDefaultDiagramName();
                    _diagramName = _state.DiagramName ?? _state.SavedLayoutName ?? "";
                    _hasDiagramMutation = _state.Nodes.Count > 0 || _state.PendingOperations.Count > 0;
                    SaveState();
                }
            }
            else
            {
                DataModelState? defaultDiagram = UsesDefaultDiagram
                    ? await ActiveDiagrams.LoadDiagramAsync(DefaultDiagramName)
                    : null;
                if (defaultDiagram is not null)
                {
                    _state = defaultDiagram;
                    _hasDiagramMutation = true;
                }
                else if (!string.IsNullOrWhiteSpace(Tab?.InitialDataModelSourceName))
                {
                    _state = await ActiveDataModels.BuildSelectionAsync(
                        [Tab.InitialDataModelSourceName],
                        DataModelSelectionMode.IncludeDirectlyRelated);
                    DataModelLayoutEngine.ArrangeAll(_state);
                    _hasDiagramMutation = _state.Nodes.Count > 0;
                }
                else
                {
                    _state = new DataModelState
                    {
                        DiagramName = DefaultDiagramName,
                        SavedLayoutName = DefaultDiagramName,
                    };
                    _showSourcesPane = true;
                    _hasDiagramMutation = false;
                }

                NormalizeZoom();
                EnsureDefaultDiagramName();
                _diagramName = _state.DiagramName ?? "";
                SaveState();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load data model: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _confirmTidyRoutes = false;
        _selectedWaypointId = null;
        _loading = true;
        _error = null;
        try
        {
            _sourceOptions = await ActiveDataModels.GetSourceOptionsAsync();
            if (!string.IsNullOrWhiteSpace(_state.DiagramName))
            {
                DataModelState? saved = await ActiveDiagrams.LoadDiagramAsync(_state.DiagramName);
                if (saved is not null)
                {
                    _state = saved;
                    _diagramSaveError = null;
                    NormalizeZoom();
                    _diagramName = saved.DiagramName ?? _diagramName;
                    _selectedNodeName = null;
                    _selectedRelationshipId = null;
                    _showInspectorPane = false;
                    _hasDiagramMutation = true;
                    SaveState();
                    return;
                }
            }

            DataModelState previous = _state;
            string[] sourceNames = previous.Nodes
                .Where(static node => !node.IsDraft)
                .Select(static node => node.Name)
                .ToArray();
            DataModelState refreshed = sourceNames.Length == 0
                ? new DataModelState()
                : await ActiveDataModels.BuildSelectionAsync(sourceNames, DataModelSelectionMode.Exact);
            PreservePositions(refreshed);
            foreach (DataModelNode draftNode in previous.Nodes.Where(static node => node.IsDraft))
                refreshed.Nodes.Add(draftNode);
            foreach (DataModelRelationship draftRelationship in previous.Relationships.Where(static relationship => relationship.Kind == DataModelRelationshipKind.Draft))
                refreshed.Relationships.Add(draftRelationship);
            foreach (string warning in DataModelGraphBuilder.PreserveConnectorLayouts(previous.Relationships, refreshed.Relationships))
                if (!refreshed.Warnings.Contains(warning, StringComparer.OrdinalIgnoreCase)) refreshed.Warnings.Add(warning);
            refreshed.DiagramName = previous.DiagramName;
            refreshed.SavedLayoutName = previous.SavedLayoutName;
            refreshed.PendingOperations = previous.PendingOperations;
            _state = refreshed;
            EnsureDefaultDiagramName();
            SaveState();
            await PersistActiveDiagramAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to refresh data model: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAllAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var existingNames = _state.Nodes
                .Select(static node => node.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            DataModelState addition = await ActiveDataModels.BuildModelAsync(autoLayoutLimit: int.MaxValue);
            Merge(addition);
            DataModelLayoutEngine.PlaceNewNodes(_state, existingNames);
            SaveState();
            await PersistActiveDiagramAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load full data model: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddSourceAsync(string sourceName, bool includeRelated)
    {
        _loading = true;
        _error = null;
        try
        {
            var existingNames = _state.Nodes
                .Select(static node => node.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            DataModelState addition = await ActiveDataModels.BuildSelectionAsync(
                [sourceName],
                includeRelated ? DataModelSelectionMode.IncludeDirectlyRelated : DataModelSelectionMode.Exact);
            Merge(addition);
            DataModelLayoutEngine.PlaceNewNodes(_state, existingNames);
            _selectedNodeName = sourceName;
            _selectedRelationshipId = null;
            SaveState();
            await PersistActiveDiagramAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to add source '{sourceName}': {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Merge(DataModelState addition)
    {
        foreach (DataModelNode node in addition.Nodes)
        {
            if (_state.Nodes.Any(existing => string.Equals(existing.Name, node.Name, StringComparison.OrdinalIgnoreCase)))
                continue;

            _state.Nodes.Add(node);
        }

        foreach (DataModelRelationship relationship in addition.Relationships)
        {
            int existingIndex = _state.Relationships.FindIndex(existing => string.Equals(existing.Id, relationship.Id, StringComparison.Ordinal));
            if (existingIndex < 0)
                _state.Relationships.Add(relationship);
            else if (relationship.IsResolved || !_state.Relationships[existingIndex].IsResolved)
            {
                DataModelRelationship existing = _state.Relationships[existingIndex];
                DataModelGraphBuilder.PreserveConnectorLayouts([existing], [relationship]);
                if (relationship.IsResolved && !existing.IsResolved && !string.IsNullOrWhiteSpace(existing.Warning))
                {
                    string obsoleteWarning = $"{existing.LeftTable}.{existing.LeftColumn}: {existing.Warning}";
                    _state.Warnings.RemoveAll(warning => string.Equals(warning, obsoleteWarning, StringComparison.OrdinalIgnoreCase));
                }
                _state.Relationships[existingIndex] = relationship;
            }
        }

        foreach (string warning in addition.Warnings)
        {
            if (!_state.Warnings.Contains(warning, StringComparer.OrdinalIgnoreCase))
                _state.Warnings.Add(warning);
        }
    }

    private void PreservePositions(DataModelState refreshed)
    {
        refreshed.ViewportX = _state.ViewportX;
        refreshed.ViewportY = _state.ViewportY;
        refreshed.Scale = CurrentScale;

        foreach (DataModelNode node in refreshed.Nodes)
        {
            DataModelNode? existing = _state.Nodes.FirstOrDefault(current => string.Equals(current.Name, node.Name, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
                continue;

            node.X = existing.X;
            node.Y = existing.Y;
            node.DetailLevel = existing.DetailLevel;
            node.IsCollapsed = existing.DetailLevel == DataModelNodeDetailLevel.Collapsed;
        }
    }

    private async Task ClearCanvas()
    {
        _confirmTidyRoutes = false;
        _selectedWaypointId = null;
        string? diagramName = _state.DiagramName;
        _state = new DataModelState
        {
            DiagramName = diagramName,
            SavedLayoutName = diagramName,
        };
        _selectedNodeName = null;
        _selectedRelationshipId = null;
        _showInspectorPane = false;
        _hasDiagramMutation = true;
        SaveState();
        await PersistActiveDiagramAsync();
    }

    private void SelectNode(string name)
    {
        _selectedWaypointId = null;
        _selectedNodeName = name;
        _selectedRelationshipId = null;
        _showInspectorPane = true;
        _renameTableName = "";
        _newColumnName = "";
    }

    private void SelectRelationship(string id)
    {
        if (_selectedRelationshipId != id) _selectedWaypointId = null;
        _selectedRelationshipId = id;
        _selectedNodeName = null;
        _showInspectorPane = true;
    }

    private void ClearSelection()
    {
        _selectedWaypointId = null;
        _selectedNodeName = null;
        _selectedRelationshipId = null;
        _showInspectorPane = false;
        _renameTableName = "";
        _newColumnName = "";
    }

    private DataModelNode? FindNode(string? name) =>
        string.IsNullOrWhiteSpace(name)
            ? null
            : _state.Nodes.FirstOrDefault(node => string.Equals(node.Name, name, StringComparison.OrdinalIgnoreCase));

    private string ColumnRenameKey(string tableName, string columnName) => $"{tableName}.{columnName}";

    private string GetColumnRenameValue(string tableName, string columnName) =>
        _columnRenameNames.TryGetValue(ColumnRenameKey(tableName, columnName), out string? value) ? value : "";

    private void SetColumnRenameValue(string tableName, string columnName, string? value)
    {
        string key = ColumnRenameKey(tableName, columnName);
        if (string.IsNullOrWhiteSpace(value))
            _columnRenameNames.Remove(key);
        else
            _columnRenameNames[key] = value;
    }

    private bool CanStageRenameColumn(DataModelNode node, DataModelColumn column)
    {
        string value = GetColumnRenameValue(node.Name, column.Name).Trim();
        return !string.IsNullOrWhiteSpace(value)
               && !HasPendingTableRename(node.Name)
               && !string.Equals(value, column.Name, StringComparison.OrdinalIgnoreCase)
               && !node.Columns.Any(existing => string.Equals(existing.Name, value, StringComparison.OrdinalIgnoreCase))
               && !_state.PendingOperations.Any(operation =>
                   operation.Kind == DataModelPendingOperationKind.RenameColumn &&
                   string.Equals(operation.TableName, node.Name, StringComparison.OrdinalIgnoreCase) &&
                   string.Equals(operation.ColumnName, column.Name, StringComparison.OrdinalIgnoreCase));
    }

    private bool HasPendingColumnDrop(string tableName, string columnName) =>
        _state.PendingOperations.Any(operation =>
            operation.Kind == DataModelPendingOperationKind.DropColumn &&
            string.Equals(operation.TableName, tableName, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(operation.ColumnName, columnName, StringComparison.OrdinalIgnoreCase));

    private bool HasPendingTableRename(string tableName) =>
        _state.PendingOperations.Any(operation =>
            operation.Kind == DataModelPendingOperationKind.RenameTable &&
            string.Equals(operation.TableName, tableName, StringComparison.OrdinalIgnoreCase));

    private async Task RemoveNode(string name)
    {
        _state.Nodes.RemoveAll(node => string.Equals(node.Name, name, StringComparison.OrdinalIgnoreCase));
        _state.Relationships.RemoveAll(relationship =>
            string.Equals(relationship.LeftTable, name, StringComparison.OrdinalIgnoreCase)
            || string.Equals(relationship.RightTable, name, StringComparison.OrdinalIgnoreCase));

        if (string.Equals(_selectedNodeName, name, StringComparison.OrdinalIgnoreCase))
            _selectedNodeName = null;
        if (_selectedRelationshipId is not null && !_state.Relationships.Any(relationship => relationship.Id == _selectedRelationshipId))
            _selectedRelationshipId = null;

        SaveState();
        await PersistActiveDiagramAsync();
    }

    private async Task OnNodeMoved(DataModelNodeMove move)
    {
        DataModelNode? node = FindNode(move.NodeName);
        if (node is not null)
        {
            node.X = move.X;
            node.Y = move.Y;
        }

        EnsureDefaultDiagramName();
        SaveState();
        await PersistActiveDiagramAsync();
    }

    private async Task AutoArrangeAsync()
    {
        DataModelLayoutEngine.ArrangeAll(_state);
        _fitAfterRender = true;
        SaveState();
        await PersistActiveDiagramAsync();
    }

    private async Task TidyModelAsync()
    {
        if (_state.Relationships.Any(static relationship => relationship.ConnectorLayout is not null))
        {
            _confirmTidyRoutes = true;
            return;
        }
        await ApplyTidyModelAsync();
    }

    private async Task ApplyTidyModelAsync()
    {
        _confirmTidyRoutes = false;
        _selectedWaypointId = null;
        foreach (DataModelRelationship relationship in _state.Relationships)
            relationship.ConnectorLayout = null;
        foreach (DataModelNode node in _state.Nodes)
        {
            node.DetailLevel = DataModelNodeDetailLevel.Keys;
            node.IsCollapsed = false;
        }

        DataModelLayoutEngine.ArrangeAll(_state);
        _fitAfterRender = true;
        SaveState();
        await PersistActiveDiagramAsync();
    }

    private void OnConnectorWaypointSelected(string? waypointId) => _selectedWaypointId = waypointId;

    private async Task OnConnectorRouteChangedAsync(DataModelConnectorLayoutChange change)
    {
        DataModelRelationship? relationship = _state.Relationships.FirstOrDefault(item => item.Id == change.RelationshipId);
        if (relationship is null) return;
        relationship.ConnectorLayout = DataModelGraphBuilder.CloneConnectorLayout(change.Layout);
        if (relationship.ConnectorLayout?.Waypoints.Any(point => point.Id == _selectedWaypointId) != true)
            _selectedWaypointId = null;
        SaveState();
        await PersistActiveDiagramAsync();
    }

    private async Task AddConnectorBendAsync()
    {
        if (_schemaCanvas is not null && CanEditSelectedConnector && SelectedRelationship is not null)
            await _schemaCanvas.AddConnectorBendAsync(SelectedRelationship.Id);
    }

    private async Task RemoveConnectorBendAsync()
    {
        if (_schemaCanvas is not null && CanRemoveSelectedBend && SelectedRelationship is not null)
            await _schemaCanvas.RemoveConnectorBendAsync(SelectedRelationship.Id);
    }

    private async Task ResetConnectorRouteAsync()
    {
        if (SelectedRelationship is not { } relationship) return;
        await OnConnectorRouteChangedAsync(new DataModelConnectorLayoutChange(relationship.Id, null));
        if (_schemaCanvas is not null)
        {
            await _schemaCanvas.OnConnectorAnnouncement("Connector route reset to automatic.");
            await _schemaCanvas.FocusConnectorAsync(relationship.Id);
        }
    }

    private async Task FitModelAsync()
    {
        if (_schemaCanvas is not null)
            await _schemaCanvas.FitModelAsync();
    }

    private async Task SetAllDetailLevelsAsync(DataModelNodeDetailLevel detailLevel)
    {
        foreach (DataModelNode node in _state.Nodes)
        {
            node.DetailLevel = detailLevel;
            node.IsCollapsed = detailLevel == DataModelNodeDetailLevel.Collapsed;
        }

        SaveState();
        await PersistActiveDiagramAsync();
    }

    private async Task OnNodeDetailChangedAsync(DataModelNodeDetailChange change)
    {
        DataModelNode? node = FindNode(change.NodeName);
        if (node is null)
            return;

        node.DetailLevel = change.DetailLevel;
        node.IsCollapsed = change.DetailLevel == DataModelNodeDetailLevel.Collapsed;
        SaveState();
        await PersistActiveDiagramAsync();
    }

    private Task OnViewportChangedAsync(DataModelViewportChange change)
    {
        _state.ViewportX = Math.Max(0, change.X);
        _state.ViewportY = Math.Max(0, change.Y);
        _state.Scale = Math.Round(NormalizeScale(change.Scale), 2);
        _hasDiagramMutation = true;
        SaveState();

        _viewportPersistCts?.Cancel();
        _viewportPersistCts?.Dispose();
        _viewportPersistCts = new CancellationTokenSource();
        _ = PersistViewportAfterDelayAsync(_viewportPersistCts);
        return Task.CompletedTask;
    }

    private async Task PersistViewportAfterDelayAsync(CancellationTokenSource source)
    {
        try
        {
            await Task.Delay(350, source.Token);
            await InvokeAsync(async () =>
            {
                if (ReferenceEquals(_viewportPersistCts, source))
                    await PersistActiveDiagramAsync();
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveDiagramAsync()
    {
        try
        {
            _hasDiagramMutation = true;
            await ActiveDiagrams.SaveDiagramAsync(_diagramName, _state);
            _diagramSaveError = null;
            _diagramName = _state.DiagramName ?? _diagramName.Trim();
            await RefreshSavedDiagramsAsync();
            SaveState();
            Toast.Success($"Data model diagram '{_diagramName}' saved.");
        }
        catch (Exception ex)
        {
            _diagramSaveError = $"Diagram changes were not saved: {ex.Message}";
            Toast.Error(_diagramSaveError);
        }
    }

    private async Task LoadDiagramAsync(string name)
    {
        _confirmTidyRoutes = false;
        _selectedWaypointId = null;
        _showLoadPanel = false;
        try
        {
            DataModelState? loaded = await ActiveDiagrams.LoadDiagramAsync(name);
            if (loaded is null)
            {
                Toast.Warning("Saved data model diagram was not found.");
                return;
            }

            _state = loaded;
            _diagramSaveError = null;
            NormalizeZoom();
            _diagramName = loaded.DiagramName ?? name;
            _hasDiagramMutation = true;
            _selectedNodeName = null;
            _selectedRelationshipId = null;
            _showInspectorPane = false;
            SaveState();
            Toast.Info($"Data model diagram '{_diagramName}' loaded.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load data model diagram: {ex.Message}");
        }
    }

    private async Task DeleteActiveDiagramAsync()
    {
        _confirmTidyRoutes = false;
        if (string.IsNullOrWhiteSpace(_state.DiagramName))
            return;

        string name = _state.DiagramName;
        try
        {
            await ActiveDiagrams.DeleteDiagramAsync(name);
            await RefreshSavedDiagramsAsync();
            _state.DiagramName = null;
            _state.SavedLayoutName = null;
            _diagramName = "";
            SaveState();
            Toast.Info($"Data model diagram '{name}' deleted.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to delete data model diagram: {ex.Message}");
        }
    }

    private async Task RefreshSavedDiagramsAsync()
