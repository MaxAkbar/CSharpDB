{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CSharpDB": "Data Source=csharpdb.db"
  },
  "CSharpDB": {
    "Observability": {
      "Enabled": false,
      "OpenTelemetry": {
        "Enabled": false,
        "SamplingRatio": 1.0,
        "Resource": {
          "ServiceName": "CSharpDB.Api",
          "ServiceNamespace": "CSharpDB"
        },
        "Otlp": {
          "Enabled": false
        },
        "Console": {
          "Enabled": false
        }
      },
      "Prometheus": {
        "Enabled": false,
        "Path": "/metrics",
        "AllowInsecureRemoteAccess": false
      },
      "Health": {
        "Enabled": true,
        "LivenessPath": "/health/live",
        "ReadinessPath": "/health/ready",
        "ReadinessTimeout": "00:00:02"
      }
    },
    "Api": {
      "Security": {
        "Mode": "None",
        "ApiKeyHeaderName": "X-CSharpDB-Api-Key"
      }
    }
  }
}
