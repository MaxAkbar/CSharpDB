<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CSharpDB.Migration.Files</AssemblyName>
    <RootNamespace>CSharpDB.Migration.Files</RootNamespace>
    <Description>Streaming file-format adapters for the CSharpDB migration pipeline.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpDB.Primitives\CSharpDB.Primitives.csproj" />
    <ProjectReference Include="..\CSharpDB.Migration\CSharpDB.Migration.csproj" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpDB.Migration.Files.Tests" />
    <InternalsVisibleTo Include="CSharpDB.Migration.CrashHarness" />
  </ItemGroup>

</Project>
