<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CSharpDB.Migration.Access</AssemblyName>
    <RootNamespace>CSharpDB.Migration.Access</RootNamespace>
    <Description>Bounded Microsoft Access retained-source adapter for the CSharpDB migration pipeline.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpDB.Migration\CSharpDB.Migration.csproj" />
    <ProjectReference Include="..\CSharpDB.Migration.Retained\CSharpDB.Migration.Retained.csproj" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpDB.Migration.Access.Tests" />
  </ItemGroup>

</Project>
