<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CSharpDB.Migration.DualRun</AssemblyName>
    <RootNamespace>CSharpDB.Migration.DualRun</RootNamespace>
    <PackageId>CSharpDB.Migration.DualRun</PackageId>
    <Description>Bounded, deterministic source-to-CSharpDB query result validation for migration cutovers.</Description>
    <PackageTags>csharp;dotnet;embedded-database;migration;validation;dual-run</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpDB.Data\CSharpDB.Data.csproj" />
    <ProjectReference Include="..\CSharpDB.Migration\CSharpDB.Migration.csproj" />
    <ProjectReference Include="..\CSharpDB.Sql\CSharpDB.Sql.csproj" />
  </ItemGroup>

</Project>
