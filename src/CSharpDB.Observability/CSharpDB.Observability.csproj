<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CSharpDB.Observability</AssemblyName>
    <RootNamespace>CSharpDB.Observability</RootNamespace>
    <PackageId>CSharpDB.Observability</PackageId>
    <Description>BCL-only observability contracts, safe diagnostics models, correlation primitives, and runtime snapshot types for CSharpDB.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpDB.Client" />
    <InternalsVisibleTo Include="CSharpDB.Data" />
    <InternalsVisibleTo Include="CSharpDB.Engine" />
    <InternalsVisibleTo Include="CSharpDB.Observability.Tests" />
    <InternalsVisibleTo Include="CSharpDB.Sql" />
    <InternalsVisibleTo Include="CSharpDB.Tests" />
  </ItemGroup>

</Project>
