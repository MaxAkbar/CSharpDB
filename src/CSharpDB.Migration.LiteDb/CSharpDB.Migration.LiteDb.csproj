<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CSharpDB.Migration.LiteDb</AssemblyName>
    <RootNamespace>CSharpDB.Migration.LiteDb</RootNamespace>
    <Description>Read-only LiteDB source inspection for the CSharpDB migration pipeline.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpDB.Migration\CSharpDB.Migration.csproj" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpDB.Migration.LiteDb.Tests" />
  </ItemGroup>

</Project>
