{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CSharpDB": "Data Source=csharpdb.db"
  },
  "CSharpDB": {
    "Observability": {
      "Enabled": false,
      "OpenTelemetry": {
        "Enabled": false,
        "SamplingRatio": 1.0,
        "Resource": {
          "ServiceName": "CSharpDB.Daemon",
          "ServiceNamespace": "CSharpDB"
        },
        "Otlp": {
          "Enabled": false
        },
        "Console": {
          "Enabled": false
        }
      },
      "Prometheus": {
        "Enabled": false,
        "Path": "/metrics",
        "AllowInsecureRemoteAccess": false
      }
    },
    "Daemon": {
      "EnableRestApi": true,
      "Security": {
        "Mode": "None",
        "ApiKeyHeaderName": "X-CSharpDB-Api-Key"
      }
    },
    "HostDatabase": {
      "OpenMode": "HybridIncrementalDurable",
      "ImplicitInsertExecutionMode": "ConcurrentWriteTransactions",
      "UseWriteOptimizedPreset": true,
      "HotTableNames": [],
      "HotCollectionNames": []
    }
  }
}
