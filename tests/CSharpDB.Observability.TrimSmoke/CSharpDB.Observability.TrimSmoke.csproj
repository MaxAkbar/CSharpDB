<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpDB.Observability\CSharpDB.Observability.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Sql\CSharpDB.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DiagnosticsTransportFixture.cs" Link="Shared\DiagnosticsTransportFixture.cs" />
  </ItemGroup>

</Project>
