<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\TestDefaults.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpDB.Admin\CSharpDB.Admin.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Primitives\CSharpDB.Primitives.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Storage\CSharpDB.Storage.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Sql\CSharpDB.Sql.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Execution\CSharpDB.Execution.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Engine\CSharpDB.Engine.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.ImportExport\CSharpDB.ImportExport.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Client\CSharpDB.Client.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Native\CSharpDB.Native.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Observability\CSharpDB.Observability.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Storage.Diagnostics\CSharpDB.Storage.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\CSharpDB.Generators\CSharpDB.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\CSharpDB.ExtensionSandbox.Worker\CSharpDB.ExtensionSandbox.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector" Version="10.0.1" />
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Update="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Update="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\ReleasedDatabases\*.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
